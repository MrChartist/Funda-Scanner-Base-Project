# Copy to .env (never commit .env). All variables are optional.

# Base URL of your own backend (see "Connecting a backend" in the README).
# Only used by src/lib/api.ts. The app works fully on mock data without it.
VITE_API_URL=http://localhost:5580

# Set to "true" to show randomly generated demo notifications (UI preview only).
VITE_DEMO_ALERTS=false

# Public base path when deploying under a sub-path (for example GitHub Pages project sites).
# Defaults to "/". Use an absolute path with leading and trailing slash.
# VITE_BASE=/Funda-Scanner-Base-Project/
